---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
const description = 'Understand the kinds of support available for evaluating Higala and where Talino describes its optional services.';
---
<SiteLayout title="Support" description={description}>
  <section class="page-hero container">
    <div class="page-hero-grid">
      <div><h1>Choose support for the work you need.</h1></div>
      <div><p>Higala's intended open software does not include a software licence fee. Infrastructure, implementation, migration, and ongoing support require their own plan.</p></div>
    </div>
  </section>

  <section class="prose-section" aria-labelledby="support-path-title">
    <div class="container prose-grid">
      <h2 id="support-path-title">For adoption and operations</h2>
      <div class="prose-copy">
        <p>Talino offers implementation, hosting, and support services. Confirm availability, service scope, responsibilities, and pricing directly with the provider before planning a deployment.</p>
        <p>The commercial loan engine is an optional extension. The intended open release does not require it. Hosting, migration, third-party services, and optional modules can carry separate costs.</p>
        <p><a class="button button-primary" href="https://talino.pages.dev/" target="_blank" rel="noreferrer">Explore Talino services <span class="arrow" aria-hidden="true">↗</span></a></p>
      </div>
    </div>
  </section>

  <section class="prose-section" aria-labelledby="self-service-title">
    <div class="container prose-grid">
      <h2 id="self-service-title">Prepare a first discussion.</h2>
      <div class="prose-copy">
        <p>For a first discussion, map one workflow, list integration and operations needs, and identify who will own them.</p>
        <ArrowLink href="/resources/prepare-for-evaluation">Prepare for an evaluation</ArrowLink>
      </div>
    </div>
  </section>
</SiteLayout>
