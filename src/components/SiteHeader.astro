---
import { withBase, routePath } from '../lib/urls';
const { activePath = '/' } = Astro.props;
const links = [
  { label: 'Platform', href: '/platform' },
  { label: 'For institutions', href: '/institutions' },
  { label: 'Developers', href: '/developers' },
  { label: 'Community', href: '/community' },
  { label: 'Resources', href: '/resources' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label="Higala home">
      <img src={withBase('/brand/higala-logo-teal.svg')} width="158" height="42" alt="Higala" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
      <span data-menu-label>Menu</span>
      <svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav id="primary-navigation" class="primary-navigation" aria-label="Main navigation" data-collapsible data-open="false">
      {links.map((link) => (
        <a href={withBase(link.href)} aria-current={routePath(activePath) === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
